#include "Updates.xcconfig"

// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Flutter AirPlay

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = tech.soit.flutterairplay

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Airplay Receiver contributors. GPL-3.0-or-later.

// The C++ player uses static third-party libraries and system media frameworks.
SWIFT_OBJC_BRIDGING_HEADER = Runner/Receiver-Bridging-Header.h
LIBRARY_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/../build/macos-native
OTHER_LDFLAGS = $(inherited) -lairplay_player
ARCHS = arm64
