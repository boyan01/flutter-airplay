set(UXPLAY_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../../vendor/UxPlay" CACHE PATH "UxPlay receive-core sources")
set(core "${UXPLAY_SOURCE}/lib")
if(NOT TARGET plist)
    include(${CMAKE_CURRENT_LIST_DIR}/Plist.cmake)
endif()
add_library(llhttp STATIC ${core}/llhttp/api.c ${core}/llhttp/http.c ${core}/llhttp/llhttp.c)
target_include_directories(llhttp PUBLIC ${core}/llhttp)
add_library(playfair STATIC ${core}/playfair/hand_garble.c ${core}/playfair/modified_md5.c
    ${core}/playfair/omg_hax.c ${core}/playfair/playfair.c ${core}/playfair/sap_hash.c)
target_include_directories(playfair PUBLIC ${core}/playfair)
file(GLOB core_sources CONFIGURE_DEPENDS "${core}/*.c")
add_library(receiver_core STATIC ${core_sources})
if(NOT WIN32)
    target_sources(receiver_core PRIVATE ${core}/dns_sd/dns_sd.c)
endif()
if(ANDROID OR AIRPLAY_DNS_STUB)
    target_sources(receiver_core PRIVATE ${CMAKE_CURRENT_LIST_DIR}/../compat/dns_sd.c)
    target_include_directories(receiver_core PRIVATE ${CMAKE_CURRENT_LIST_DIR}/../compat)
endif()
target_include_directories(receiver_core PUBLIC ${core})
target_compile_definitions(receiver_core PRIVATE PLIST_210 PLIST_230)
include(${CMAKE_CURRENT_LIST_DIR}/Crypto.cmake)
target_link_libraries(receiver_core PUBLIC plist llhttp playfair airplay_crypto)
