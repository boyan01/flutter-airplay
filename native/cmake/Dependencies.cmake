# Third-party sources pinned in native/dependencies.lock.json. Each archive is
# downloaded once per machine into AIRPLAY_DEPENDENCY_CACHE, checked against its
# SHA-256 and extracted beside it; builds share the read-only source tree.
# AIRPLAY_<NAME>_SOURCE selects a local source tree instead, e.g. offline.
include_guard(GLOBAL)
set(airplay_lock_file "${CMAKE_CURRENT_LIST_DIR}/../dependencies.lock.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${airplay_lock_file}")
file(READ "${airplay_lock_file}" airplay_lock)
if(DEFINED ENV{LOCALAPPDATA})
    set(airplay_cache_default "$ENV{LOCALAPPDATA}/flutter-airplay")
elseif(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
    set(airplay_cache_default "$ENV{XDG_CACHE_HOME}/flutter-airplay")
else()
    set(airplay_cache_default "$ENV{HOME}/.cache/flutter-airplay")
endif()
set(AIRPLAY_DEPENDENCY_CACHE "${airplay_cache_default}" CACHE PATH "Downloaded native dependency sources")

function(airplay_dependency name out)
    string(TOUPPER "${name}" upper)
    set(AIRPLAY_${upper}_SOURCE "" CACHE PATH "Local ${name} source instead of the pinned archive")
    if(AIRPLAY_${upper}_SOURCE)
        set(${out} "${AIRPLAY_${upper}_SOURCE}" PARENT_SCOPE)
        return()
    endif()
    string(JSON url GET "${airplay_lock}" ${name} archive)
    string(JSON sha256 GET "${airplay_lock}" ${name} sha256)
    get_filename_component(archive_name "${url}" NAME)
    # Release archives unpack into a directory named like the archive.
    string(REGEX REPLACE "\\.tar\\.(gz|bz2|xz)$" "" stem "${archive_name}")
    set(cache "${AIRPLAY_DEPENDENCY_CACHE}")
    set(source "${cache}/${stem}")
    set(${out} "${source}" PARENT_SCOPE)
    if(EXISTS "${source}/.airplay-sha256")
        file(READ "${source}/.airplay-sha256" extracted)
        if(extracted STREQUAL sha256)
            return()
        endif()
    endif()
    # Unique scratch names: concurrent configures may fetch the same archive.
    string(RANDOM LENGTH 8 token)
    set(archive "${cache}/${archive_name}")
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" actual)
    endif()
    if(NOT actual STREQUAL sha256)
        message(STATUS "Downloading ${url}")
        file(DOWNLOAD "${url}" "${archive}.${token}" EXPECTED_HASH SHA256=${sha256} STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${archive}.${token}")
            list(GET status 1 reason)
            message(FATAL_ERROR "Cannot download ${name} (${reason}). Retry, or set AIRPLAY_${upper}_SOURCE "
                "to its ${stem} source, or place ${archive_name} in ${cache}.")
        endif()
        file(RENAME "${archive}.${token}" "${archive}")
    endif()
    set(scratch "${cache}/extract-${stem}-${token}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${scratch}")
    file(WRITE "${scratch}/${stem}/.airplay-sha256" "${sha256}")
    if(EXISTS "${source}/.airplay-sha256")
        file(READ "${source}/.airplay-sha256" extracted)
    endif()
    if(NOT extracted STREQUAL sha256)
        # A stale or partial tree from another pin.
        file(REMOVE_RECURSE "${source}")
    endif()
    # Fails when a concurrent configure has just put the same tree in place.
    file(RENAME "${scratch}/${stem}" "${source}" RESULT moved)
    file(REMOVE_RECURSE "${scratch}")
    if(NOT moved EQUAL 0 AND NOT EXISTS "${source}/.airplay-sha256")
        message(FATAL_ERROR "Cannot extract ${archive} into ${source}: ${moved}")
    endif()
endfunction()
